# Backend
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true&w=majority

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=YOUR_PINECONE_KEY
PINECONE_INDEX=coursepilot
PINECONE_NAMESPACE=default

# Supabase Storage (server-side)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=course-materials

# Public URL generation (optional)
SUPABASE_PUBLIC_BUCKET=true
